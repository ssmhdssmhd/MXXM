<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/sm_15" />
            <gradient android:startColor="#fff60b0b" android:endColor="#b0221901" android:angle="0.0" />
            <stroke android:width="@dimen/sm_2" android:color="#fff6f1f1" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/sm_15" />
            <gradient android:startColor="#b0221901" android:endColor="#fff60b0b" android:angle="0.0" />
            <stroke android:width="@dimen/sm_2" android:color="@color/white" />
        </shape>
    </item>
</selector>