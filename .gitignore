# 依赖
/vendor/
composer.phar

# 日志
*.log
logs/

# 缓存（保留 cache 目录本身，忽略其中的运行时缓存文件）
cache/*
!cache/.gitkeep
tmp/
temp/

# 官替算法运行时缓存
mx1/m3u8/
mx1/Cache/
mx2/data/cache/
mx2/data/logs/
mx2/data/site_health.json

# 环境
.env
.env.local

# 编辑器
.idea/
.vscode/
.DS_Store
Thumbs.db

# 构建产物
build/
dist/
*.phar

# ===== mx2 运行时数据（用户生产环境修改后被 git 覆盖会导致配置丢失）=====
mx2/config/settings.json
mx2/config/sites.json
mx2/config/mapping.json
mx2/data/
mx2/config/.env.ini
